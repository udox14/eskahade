/backup_*.sql
/*_backup_*.sql
/backup*.sql
/*backup*.sql
/*snapshot*.sql
uat_fixtures_*.sql
temp_*.sql
*audit_result*.json
*rehearsal*.json

# secrets
/.secrets/

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

#dll
/.claude
/.codex
