{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eskahade-finance-billing-sandbox",
  "account_id": "a170ed4144c00927988a828aa9a41896",
  "main": "workers/finance-billing.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "vars": {"ESKAHADE_ENV":"sandbox","FINANCE_BILLING_AUTO_ENABLED":"false"},
  "triggers": {"crons":["*/5 * * * *"]},
  "observability": {"enabled":true,"head_sampling_rate":1},
  "d1_databases": [
    {"binding":"DB","database_name":"eskahade-demo-db","database_id":"677f05ba-9b52-4534-9542-96cc785f25e4"},
    {"binding":"DEMO_DB","database_name":"eskahade-demo-db","database_id":"677f05ba-9b52-4534-9542-96cc785f25e4"}
  ],
  "env": {
    "production": {
      "name":"eskahade-finance-billing",
      "vars":{"ESKAHADE_ENV":"production","FINANCE_BILLING_AUTO_ENABLED":"false"},
      "triggers":{"crons":["*/5 * * * *"]},
      "d1_databases":[{"binding":"DB","database_name":"eskahade-db","database_id":"a2010f08-f314-46af-88fd-dbb9b4ef1bb1"}]
    }
  }
}
