{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eskahade-notification-dispatch-sandbox",
  "account_id": "a170ed4144c00927988a828aa9a41896",
  "main": "workers/notification-dispatch.ts",
  "compatibility_date": "2026-10-21",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "vars": {"ESKAHADE_ENV":"sandbox","NOTIFICATIONS_DISPATCH_ENABLED":"true"},
  "triggers": {"crons":["*/2 * * * *"]},
  "observability": {"enabled":true,"head_sampling_rate":1},
  "d1_databases": [
    {"binding":"DB","database_name":"eskahade-demo-db","database_id":"677f05ba-9b52-4534-9542-96cc785f25e4"},
    {"binding":"DEMO_DB","database_name":"eskahade-demo-db","database_id":"677f05ba-9b52-4534-9542-96cc785f25e4"}
  ],
  "env": {
    "production": {
      "name":"eskahade-notification-dispatch",
      // Production diaktifkan eksplisit setelah migration 0202 diterapkan & diuji di sandbox.
      "vars":{"ESKAHADE_ENV":"production","NOTIFICATIONS_DISPATCH_ENABLED":"false"},
      "triggers":{"crons":["*/2 * * * *"]},
      "d1_databases":[{"binding":"DB","database_name":"eskahade-db","database_id":"a2010f08-f314-46af-88fd-dbb9b4ef1bb1"}]
    }
  }
}
