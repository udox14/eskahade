{
 "$schema": "node_modules/wrangler/config-schema.json",
 "name": "eskahade-pengajian-photo-cleanup",
 "preview_urls": false,
 "vars": {"ESKAHADE_ENV":"production"},
 "main": "workers/pengajian-photo-cleanup.ts",
 "compatibility_date": "2026-09-30",
 "compatibility_flags": ["nodejs_compat"],
 "triggers": {"crons": ["*/15 * * * *"]},
 "observability": {"enabled": true,"head_sampling_rate": 1},
 "d1_databases": [
  {"binding":"DB","database_name":"eskahade-db","database_id":"a2010f08-f314-46af-88fd-dbb9b4ef1bb1"}
 ],
 "r2_buckets": [{"binding":"R2_BUCKET","bucket_name":"eskahade-foto","preview_bucket_name":"eskahade-foto-preview"}]
}
