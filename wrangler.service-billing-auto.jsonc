{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eskahade-service-billing-auto",
  "main": "workers/service-billing-auto.ts",
  "compatibility_date": "2026-05-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": [
      "0 1 * * *"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "eskahade-db",
      "database_id": "a2010f08-f314-46af-88fd-dbb9b4ef1bb1",
      "remote": true
    },
    {
      "binding": "FINANCE_DB",
      "database_name": "eskahade-finance",
      "database_id": "8388b81f-c5c7-4523-9a72-437f947331a1",
      "remote": true
    }
  ]
}
